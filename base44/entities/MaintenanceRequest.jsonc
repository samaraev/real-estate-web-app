{
  "name": "MaintenanceRequest",
  "type": "object",
  "properties": {
    "lease_id": {
      "type": "string"
    },
    "property_title": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "urgent"
      ],
      "default": "normal",
      "enumColors": [
        "gray",
        "blue",
        "red"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "waiting",
        "done",
        "cancelled"
      ],
      "default": "new",
      "enumColors": [
        "yellow",
        "blue",
        "purple",
        "green",
        "gray"
      ]
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cost": {
      "type": "number"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}