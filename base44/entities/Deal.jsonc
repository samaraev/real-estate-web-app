{
  "name": "Deal",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "listing_title": {
      "type": "string"
    },
    "property_title": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "buyer_user_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_phone": {
      "type": "string"
    },
    "agent_user_id": {
      "type": "string"
    },
    "agency_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "stage": {
      "type": "string",
      "enum": [
        "inquiry",
        "viewing",
        "offer",
        "deposit",
        "documents",
        "closing",
        "won",
        "lost"
      ],
      "default": "inquiry",
      "enumColors": [
        "gray",
        "blue",
        "yellow",
        "purple",
        "blue",
        "yellow",
        "green",
        "red"
      ]
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "escrow": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "commission": {
      "type": "number"
    },
    "next_follow_up": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "stage"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "data.agent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "data.agent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}