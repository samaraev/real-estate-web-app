{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "lease_contract",
        "deposit_receipt",
        "handover_act",
        "sale_contract",
        "other"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "yellow",
        "gray"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "en"
      ],
      "default": "ru",
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "lease_id": {
      "type": "string"
    },
    "deal_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_url": {
      "type": "string"
    },
    "content": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "partially_signed",
        "signed",
        "declined"
      ],
      "default": "draft",
      "enumColors": [
        "gray",
        "blue",
        "yellow",
        "green",
        "red"
      ]
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participants": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participants": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}