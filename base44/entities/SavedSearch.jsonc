{
  "name": "SavedSearch",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "filters": {
      "type": "object"
    },
    "alerts_enabled": {
      "type": "boolean",
      "default": true
    },
    "last_notified_at": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}