{
  "name": "Property",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "apartment",
        "house",
        "room",
        "commercial",
        "land"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "yellow",
        "gray"
      ]
    },
    "city": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "metro": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "rooms": {
      "type": "number"
    },
    "area": {
      "type": "number"
    },
    "floor": {
      "type": "number"
    },
    "floors": {
      "type": "number"
    },
    "year_built": {
      "type": "number"
    },
    "is_rented": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "city"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}