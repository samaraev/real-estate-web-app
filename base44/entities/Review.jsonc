{
  "name": "Review",
  "type": "object",
  "properties": {
    "target_user_id": {
      "type": "string"
    },
    "target_role": {
      "type": "string",
      "enum": [
        "owner",
        "tenant",
        "agent"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ]
    },
    "author_name": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "deal_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "published",
        "rejected"
      ],
      "default": "pending",
      "enumColors": [
        "yellow",
        "green",
        "red"
      ]
    }
  },
  "required": [
    "rating",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}