{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "owner_pro",
        "agency"
      ],
      "default": "free",
      "enumColors": [
        "gray",
        "blue",
        "purple"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "cancelled"
      ],
      "default": "active",
      "enumColors": [
        "green",
        "yellow",
        "red"
      ]
    },
    "listing_quota": {
      "type": "number"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "payment_ref": {
      "type": "string"
    }
  },
  "required": [
    "plan"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}