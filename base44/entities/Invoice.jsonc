{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "lease_id": {
      "type": "string"
    },
    "number": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "tenant_user_id": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "total": {
      "type": "number"
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "partially_paid",
        "paid",
        "overdue",
        "cancelled",
        "refunded"
      ],
      "default": "draft",
      "enumColors": [
        "gray",
        "blue",
        "yellow",
        "green",
        "red",
        "gray",
        "purple"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "rent",
        "utilities",
        "extra",
        "deposit",
        "late_fee"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "yellow",
        "red"
      ]
    },
    "late_fee": {
      "type": "number",
      "default": 0
    },
    "note": {
      "type": "string"
    },
    "reminders_sent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "lease_id",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.tenant_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}