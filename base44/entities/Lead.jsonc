{
  "name": "Lead",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string"
    },
    "agent_user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "site",
        "call",
        "telegram",
        "xml_feed",
        "referral"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "yellow",
        "gray"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "viewing",
        "negotiation",
        "won",
        "lost"
      ],
      "default": "new",
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "yellow",
        "green",
        "red"
      ]
    },
    "listing_id": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "commission": {
      "type": "number"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_follow_up": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.agent_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.agent_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}