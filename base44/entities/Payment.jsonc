{
  "name": "Payment",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "payer_user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "method": {
      "type": "string",
      "enum": [
        "card",
        "sbp",
        "bank_transfer"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "refunded",
        "partial"
      ],
      "default": "pending",
      "enumColors": [
        "yellow",
        "green",
        "red",
        "purple",
        "blue"
      ]
    },
    "provider": {
      "type": "string",
      "default": "mock"
    },
    "provider_ref": {
      "type": "string"
    },
    "receipt_number": {
      "type": "string"
    },
    "fee_amount": {
      "type": "number",
      "default": 0
    },
    "payer_name": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "invoice_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.payer_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}