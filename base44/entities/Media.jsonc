{
  "name": "Media",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "photo",
        "video",
        "plan",
        "document"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray"
      ]
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_cover": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "listing_id",
    "file_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}