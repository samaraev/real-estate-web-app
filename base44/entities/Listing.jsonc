{
  "name": "Listing",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "deal_type": {
      "type": "string",
      "enum": [
        "sale",
        "rent"
      ],
      "enumColors": [
        "purple",
        "blue"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "apartment",
        "house",
        "room",
        "commercial",
        "land"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "yellow",
        "gray"
      ]
    },
    "property_id": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "en"
      ],
      "default": "ru",
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "title_en": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "deposit": {
      "type": "number"
    },
    "utilities_included": {
      "type": "boolean",
      "default": false
    },
    "city": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "metro": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "area": {
      "type": "number"
    },
    "rooms": {
      "type": "number"
    },
    "floor": {
      "type": "number"
    },
    "floors": {
      "type": "number"
    },
    "year_built": {
      "type": "number"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pets_allowed": {
      "type": "boolean",
      "default": false
    },
    "children_allowed": {
      "type": "boolean",
      "default": true
    },
    "cover_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "floor_plan_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "published",
        "rejected",
        "archived",
        "rented",
        "sold"
      ],
      "default": "draft",
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "red",
        "gray",
        "blue",
        "purple"
      ]
    },
    "rejection_reason": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_phone": {
      "type": "string"
    },
    "agency_id": {
      "type": "string"
    },
    "agency_name": {
      "type": "string"
    },
    "is_verified_owner": {
      "type": "boolean",
      "default": false
    },
    "boost_until": {
      "type": "string"
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "price_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "moderation_note": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "deal_type",
    "city"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}